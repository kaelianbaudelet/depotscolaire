{% extends 'base.html.twig' %}

{% block title %}Modifier la classe{% endblock %}

{% block body %}
<div class="center-wrapper">
    <div class="auth-card">
        <h1 class="auth-header">Modifier la classe</h1>

        {{ form_start(form) }}
            <div class="field-group">
                {{ form_row(form.name, {'attr': {'class': 'form-input'}}) }}
            </div>


            <div class="form-actions">
                <button class="app-btn app-btn--primary">Enregistrer</button>
                 <a href="{{ path('app_classroom_show', {'id': classroom.id}) }}" class="app-btn app-btn--primary btn-secondary">Annuler</a>
            </div>
        {{ form_end(form) }}
        
        <div class="form-footer">
            {{ include('classroom/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}
