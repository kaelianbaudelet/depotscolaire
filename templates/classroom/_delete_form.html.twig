<form method="post" action="{{ path('app_classroom_delete', {'id': classroom.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette classe ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ classroom.id) }}">
    <button class="app-btn btn-danger w-100">Supprimer la classe</button>
</form>
