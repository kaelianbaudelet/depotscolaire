{% extends 'base.html.twig' %}

{% extends 'base.html.twig' %}

{% block body %}
<div class="page-wrapper">
    <h1 class="page-header__title page-header--center">
        ÉDITION DES UTILISATEURS
<div class="page-wrapper mt-lg">
    <div class="resource-card auth-card--wide center-auto">
        <h1 class="page-header__title text-center">
            Modifier : {{ user.firstName }} {{ user.lastName }}
        </h1>
        <div class="text-center">
            <span class="text-muted">{{ user.email }}</span>
        </div>

        {{ form_start(form) }}
            <div class="field-group">
                {{ form_row(form.roles, {'attr': {'class': 'form-input'}}) }}
            </div>
            
            <div class="section-header">
                Informations
            </div>
            
            <div class="row">
                 <div class="field-group">
                    {{ form_row(form.firstName, {'attr': {'class': 'form-input'}}) }}
                 </div>
                 <div class="field-group">
                    {{ form_row(form.lastName, {'attr': {'class': 'form-input'}}) }}
                 </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="app-btn app-btn--primary btn-full">Enregistrer les modifications</button>
            </div>
        {{ form_end(form) }}
    </div>

    <div class="text-center mt-lg">
        <a href="{{ path('app_admin_users') }}" class="app-btn app-btn--primary btn-secondary">Retour à la liste</a>
    </div>
</div>
{% endblock %}
