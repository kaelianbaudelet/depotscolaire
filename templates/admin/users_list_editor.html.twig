{% extends 'base.html.twig' %}

{% block body %}
	<div class="container-fluid">
		<h1 class="text-center text-primary mt-4 pt-4 display-1 fw-bold">
			LISTE DES UTILISATEURS
		</h1>

		<div class="row justify-content-center">
			<div class="col-12 col-md-10 bg-white p-4 text-primary">

				<div class="table-responsive">
					<table class="table table-hover">
						<div class="accordion" id="accordionExample">
							{% for user in users %}
								<tr class="{{ cycle(['table-primary', 'table-secondary'], loop.index0) }}">

									<td colspan="8">
										<div class="accordion" id="accordionExample">
											<div class="accordion-item">
												<h2 class="accordion-header">
													<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse{{ user.id }}" aria-expanded="false" aria-controls="collapse{{ user.id }}">
														{{ user.lastname }}
														{{ user.firstname }}
													</button>
												</h2>
												<div id="collapse{{ user.id }}" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
													<div class="accordion-body">
														{{ form_start(forms[user.id]) }}
														{{ form_widget(forms[user.id]) }}
														{{ form_end(forms[user.id]) }}
													</div>
												</div>
											</div>
										</td>
									</td>
								</tr>
							{% endfor %}
						</div>


					</div>

				</div>
			</div>
		</div>
		<div class="accordion" id="accordionExample">


		{% endblock %}
