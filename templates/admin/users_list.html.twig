{% extends 'base.html.twig' %}

{% block body %}
	<div class="container-fluid">
		<h1 class="text-center text-primary mt-4 pt-4 display-1 fw-bold">
			LISTE DES UTILISATEURS
		</h1>

		<div class="row justify-content-center">
			<div class="col-12 col-md-10 bg-white p-4 text-primary">
				<div class="accordion" id="accordionExample">
					<div class="accordion-item">
						<h2 class="accordion-header">
							<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse" aria-expanded="false" aria-controls="collapse">
								<p>logs</p>
							</button>
						</h2>
						<div id="collapse" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
							<div class="accordion-body">
								<table class="table table-hover">
									<thead>
										<tr class="fw-bold text-primary">
											<th>utilisateur</th>
											<th>id_utilisateur</th>
											<th>date</th>
											<th>navigateur</th>
											<th>ip</th>
										</tr>
									</thead>
									<tbody>
										{% for log in logs %}
											<tr>
												<th>{{log.user.firstName}}</th>
												<th>{{log.user.id}}</th>
												<th>{{log.loginAt|date('s:m:h d/m/Y')}}</th>
												<th>{{log.userAgent}}</th>
												<th>{{log.ip}}</th>
											</tr>
										{% endfor %}
									</tbody>
								</table>
							</div>
						</div>
					</div>
				</div>
				<div class="table-responsive">
					<table class="table table-hover">
						<thead>
							<tr class="fw-bold text-primary">
								<th>Email</th>
								<th>Date de Création</th>
								<th>Rôle(s)</th>
								<th>Nom Prénom</th>
								<th>Adresse</th>
								<th>Ville</th>
								<th>Statut</th>
							</tr>
						</thead>

						<tbody>
							{% for user in users %}
								<tr class="{{ cycle(['table-primary', 'table-secondary'], loop.index0) }}">
									<td>{{ user.email }}</td>
									<td>
										{{ user.createdAt|date('d/m/Y') }}
									</td>
									<td>
										{% if "ROLE_ADMIN" in user.roles %}
											ADMIN
										{% elseif "ROLE_MODERATOR" in user.roles %}
											MOD
										{% else %}
											USER
										{% endif %}
									</td>
									<td>{{ user.firstName }}
										{{ user.lastName }}</td>
									<td>{{ user.address }}</td>
									<td>{{ user.city }}</td>
									<td>
										{% if user.isSuspended() %}
											SUSPENDU
										{% else %}
											ACTIF
										{% endif %}
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
					<div class="text-end pt-3">
						<a href="{{ path('app_users_list_editor') }}">
							<i class="bi bi-pen-fill text-dark"></i>
						</a>
					</div>
				</div>

			</div>
		</div>
	</div>
{% endblock %}
