{% extends 'base.html.twig' %}

{% block body %}
    <div class="page-wrapper">
        <h1 class="page-header__title page-header--center">
            Tableau de bord Administrateur
        </h1>

        <!-- Tabs Navigation -->
        <div class="tabs">
            <button class="tab-btn active" onclick="openTab(event, 'users')">Utilisateurs</button>
            <button class="tab-btn" onclick="openTab(event, 'logs')">Journaux de Connexion</button>
        </div>

        <!-- Users Tab -->
        <div id="users" class="tab-panel active">
            <div class="resource-card">
                
                <!-- Header removed as per request -->

                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Email</th>
                                <th>Rôles</th>
                                <th>Statut</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for user in users %}
                                <tr>
                                    <td>
                                        <strong>{{ user.firstName }} {{ user.lastName }}</strong><br>
                                        <small class="text-muted">{{ user.email }}</small>
                                    </td>
                                    <td>
                                        {% if 'ROLE_ADMIN' in user.roles %}
                                            <span class="admin-badge admin-badge--admin">ADMIN</span>
                                        {% elseif 'ROLE_TEACHER' in user.roles %}
                                            <span class="admin-badge admin-badge--mod">MOD</span>
                                        {% else %}
                                            USER
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if user.isSuspended %}
                                            <span class="admin-badge admin-badge--banned">SUSPENDU</span>
                                        {% else %}
                                            <span class="admin-badge admin-badge--active">ACTIF</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div style="display: flex; gap: 0.5rem; align-items: center;">
                                            <button onclick="openModal('userEditModal-{{ user.id }}')" class="app-btn app-btn--primary btn-outline-primary app-btn-sm">
                                                Modifier
                                            </button>

                                            {% if user.isSuspended %}
                                                <form action="{{ path('app_admin_user_toggle_ban', {'id': user.id}) }}" method="post" class="delete-form">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_ban' ~ user.id) }}">
                                                    <button class="app-btn app-btn--primary btn-success app-btn-sm">Réactiver</button>
                                                </form>
                                            {% else %}
                                                <form action="{{ path('app_admin_user_toggle_ban', {'id': user.id}) }}" method="post" class="delete-form">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_ban' ~ user.id) }}">
                                                    <button class="app-btn app-btn--primary btn-warning app-btn-sm">Suspendre</button>
                                                </form>
                                            {% endif %}

                                            <form action="{{ path('app_admin_user_delete', {'id': user.id}) }}" method="post" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer définitivement cet utilisateur ?');" class="delete-form">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                                <button type="submit" class="app-btn app-btn--danger app-btn-sm">Supprimer</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="4" class="empty-state">Aucun utilisateur trouvé.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

            </div>
        </div>

        <!-- Modals for User Editing (Placed outside table to avoid layout issues) -->
        {% for user in users %}
            <div id="userEditModal-{{ user.id }}" class="modal-overlay">
                <div class="modal">
                    <div class="modal-header">
                        <h3 class="modal-title">Modifier {{ user.email }}</h3>
                        <button class="modal-close" onclick="closeModal('userEditModal-{{ user.id }}')">&times;</button>
                    </div>
                    <div class="modal-body">
                        {% if forms[user.id] is defined %}
                            {{ form_start(forms[user.id]) }}
                                <div class="field-group">
                                    {{ form_row(forms[user.id].firstName) }}
                                </div>
                                <div class="field-group">
                                    {{ form_row(forms[user.id].lastName) }}
                                </div>
                                <div class="field-group">
                                    {{ form_row(forms[user.id].email) }}
                                </div>
                                <div class="field-group">
                                    {{ form_row(forms[user.id].roles) }}
                                </div>
                                    <div class="field-group">
                                    {{ form_row(forms[user.id].address) }}
                                </div>
                                    <div class="field-group">
                                    {{ form_row(forms[user.id].postalCode) }}
                                </div>
                                    <div class="field-group">
                                    {{ form_row(forms[user.id].city) }}
                                </div>
                                
                                <div class="form-actions mt-lg">
                                    <button class="app-btn app-btn--primary w-100">Enregistrer</button>
                                </div>
                                <div style="display:none;">
                                    {{ form_rest(forms[user.id]) }}
                                </div>
                            {{ form_end(forms[user.id]) }}
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}

        <!-- Logs Tab -->
        <div id="logs" class="tab-panel">
            <div class="resource-card">
                <h3 class="mb-md">Historique des connexions</h3>
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Utilisateur</th>
                                <th>IP</th>
                                <th>Navigateur</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for log in logs %}
                                <tr>
                                    <td>{{ log.loginAt ? log.loginAt|date('d/m/Y H:i:s') : 'N/A' }}</td>
                                    <td>
                                        {% if log.User %}
                                            {{ log.User.email }}
                                        {% else %}
                                            <span class="text-muted">Utilisateur supprimé</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ log.ip }}</td>
                                    <td title="{{ log.userAgent }}">{{ log.userAgent|slice(0, 50) }}...</td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="4" class="text-center">Aucun journal de connexion.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <script>
            // Tabs Logic
            function openTab(evt, tabName) {
                var i, tabContent, tabLinks;
                tabContent = document.getElementsByClassName("tab-panel");
                for (i = 0; i < tabContent.length; i++) {
                    tabContent[i].classList.remove("active");
                }
                tabLinks = document.getElementsByClassName("tab-btn");
                for (i = 0; i < tabLinks.length; i++) {
                    tabLinks[i].classList.remove("active");
                }
                document.getElementById(tabName).classList.add("active");
                evt.currentTarget.classList.add("active");
            }
        </script>
    </div>
{% endblock %}
