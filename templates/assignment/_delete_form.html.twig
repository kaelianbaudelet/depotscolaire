<form method="post" action="{{ path('app_assignment_delete', {'id': assignment.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce devoir ?');" class="delete-form">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ assignment.id) }}">
    <button class="app-btn app-btn--danger">Supprimer</button>
</form>
