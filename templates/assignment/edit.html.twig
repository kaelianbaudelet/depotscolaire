{% extends 'base.html.twig' %}

{% block title %}Modifier le devoir{% endblock %}

{% block body %}
<div class="center-wrapper">
    <div class="auth-card auth-card--wide">
        <h1>Modifier le devoir</h1>

        {{ form_start(form) }}
            <div class="field-group">
                {{ form_row(form.title, {'attr': {'class': 'form-input'}}) }}
            </div>
            <div class="field-group">
                {{ form_row(form.description, {'attr': {'class': 'form-input', 'rows': '10'}}) }}
            </div>
            <div class="field-group">
                {{ form_row(form.dueDate, {'attr': {'class': 'form-input'}}) }}
            </div>
             <div class="field-group">
                {{ form_row(form.attachmentFiles, {'attr': {'class': 'form-input'}}) }}
            </div>

            <div class="form-actions">
                <button class="app-btn app-btn--primary">Enregistrer</button>
                <a href="{{ path('app_assignment_show', {'id': assignment.id}) }}" class="app-btn app-btn--primary btn-secondary">Annuler</a>
            </div>
        {{ form_end(form) }}
        
        {% if assignment.attachments is not empty %}
                <div class="mt-4">
                    <h3>Fichiers actuels :</h3>
                    <ul class="list-group">
                        {% for attachment in assignment.attachments %}
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>
                                    <i class="bi bi-file-earmark-text me-2"></i>{{ attachment }}
                                </span>
                                <form method="post" action="{{ path('app_assignment_delete_attachment', {'id': assignment.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce fichier ?');" class="m-0">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_attachment' ~ assignment.id ~ attachment) }}">
                                    <input type="hidden" name="filename" value="{{ attachment }}">
                                    <button class="app-btn btn-outline-danger app-btn-sm">
                                        <i class="bi bi-trash"></i> Supprimer
                                    </button>
                                </form>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
            
             <div class="mt-4 border-top pt-3">
                {{ include('assignment/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
