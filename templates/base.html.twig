<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>
			{% block title %}Bases -
			{% endblock %}
		</title>
		{% block stylesheets %}
			{{ encore_entry_link_tags('app') }}
		{% endblock %}
	</head>
	<body>
		<header class="app-header">
			<div class="app-container app-header__content">
				<a class="app-header__brand" href="{{path('app_accueil')}}">Boite de Rendu</a>
				
				<button class="app-header__toggle" type="button" aria-label="Menu">
					<span>☰</span>
				</button>

				<nav class="app-header__nav">
					{% set currentRoute = app.request.attributes.get('_route') %}
					
					<a class="app-header__link {{ currentRoute starts with 'app_accueil' ? 'app-header__link--active' }}" href="{{ path('app_accueil') }}">Accueil</a>
					
					{% if app.user %}
						<a class="app-header__link {{ currentRoute starts with 'app_classroom' ? 'app-header__link--active' }}" href="{{ path('app_classroom_index') }}">
							{{ 'ROLE_ADMIN' in app.user.roles ? 'Classes' : 'Mes Classes' }}
						</a>
					{% endif %}

					{% if app.user and 'ROLE_ADMIN' in app.user.roles %}
						<a class="app-header__link" href="{{ path('app_users_list') }}">Administration</a>
					{% endif %}

					{% if app.user %}
						<div class="dropdown">
							<button class="app-header__link dropdown-toggle" type="button" aria-expanded="false">
								{{ app.user.firstName ?? app.user.userIdentifier }}
								<span class="dropdown-arrow">▼</span>
							</button>
							<div class="dropdown-menu">
								<a class="dropdown-item" href="{{ path('app_profile') }}">Mon Profil</a>
								<div class="dropdown-divider"></div>
								<a class="dropdown-item text-danger" href="{{ path('app_logout') }}">Déconnexion</a>
							</div>
						</div>
					{% else %}
						<a class="app-header__link" href="{{ path('app_login') }}">Connexion</a>
						<a class="app-header__link" href="{{ path('app_register') }}">Inscription</a>
					{% endif %}
				</nav>
			</div>
		</header>

		<main class="page-section">
			<div class="app-container">
				{% block flash_messages %}
					{{ include('components/_flash_messages.html.twig') }}
				{% endblock %}
				
				{% block body %}Base{% endblock %}
			</div>
		</main>
		{% block javascripts %}
			{{ encore_entry_script_tags('app') }}
		{% endblock %}
	</body>
</html>
