{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}


{% block body %}
<div class="auth-container">
    <div class="auth-card">
        <h1 class="auth-header">Créer un compte</h1>

        {{ form_start(registrationForm) }}
            <div class="field-group">
                {{ form_row(registrationForm.email, {'attr': {'class': 'form-input'}}) }}
            </div>
            
            <div class="auth-grid">
                <div class="field-group">
                    {{ form_row(registrationForm.firstName, {'attr': {'class': 'form-input'}}) }}
                </div>
                <div class="field-group">
                    {{ form_row(registrationForm.lastName, {'attr': {'class': 'form-input'}}) }}
                </div>
            </div>

            <div class="form-group">
                {{ form_label(registrationForm.userRole, null, {'label_attr': {'class': 'form-label'}}) }}
                <div class="role-selection">
                    {% for child in registrationForm.userRole %}
                        <div class="radio-option">
                            {{ form_widget(child) }}
                            {{ form_label(child) }}
                        </div>
                    {% endfor %}
                </div>
                {{ form_errors(registrationForm.userRole) }}
            </div>

            <div class="field-group">
                {{ form_row(registrationForm.address, {'attr': {'class': 'form-input'}}) }}
            </div>

            <div class="form-row-city">
                <div class="field-group">
                    {{ form_row(registrationForm.city, {'attr': {'class': 'form-input'}}) }}
                </div>
                <div class="field-group">
                    {{ form_row(registrationForm.postalCode, {'attr': {'class': 'form-input'}}) }}
                </div>
            </div>

            <div class="field-group">
                {{ form_row(registrationForm.plainPassword, {'attr': {'class': 'form-input'}}) }}
            </div>
            
            <div class="field-group">
                 <div class="form-checkbox-group">
                    {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'form-checkbox-input'}}) }}
                    {{ form_label(registrationForm.agreeTerms, null, {'label_attr': {'class': 'form-checkbox-label'}}) }}
                </div>
            </div>


            <div class="form-actions">
                <button type="submit" class="app-btn app-btn--primary btn-full">S'inscrire</button>
            </div>
        {{ form_end(registrationForm) }}

        <p class="auth-footer">
            Déjà un compte ? <a href="{{ path('app_login') }}" class="auth-footer__link">Se connecter</a>
        </p>
    </div>
</div>
{% endblock %}
