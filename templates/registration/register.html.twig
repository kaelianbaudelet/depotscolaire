{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% form_theme registrationForm 'bootstrap_5_layout.html.twig' %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-xl-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h3 mb-4 text-center">Creer un compte</h1>

                    {{ form_start(registrationForm) }}
                        {{ form_row(registrationForm.firstName) }}
                        {{ form_row(registrationForm.lastName) }}
                        {{ form_row(registrationForm.email) }}
                        {{ form_row(registrationForm.address) }}
                        <div class="row">
                            <div class="col-md-7">
                                {{ form_row(registrationForm.city) }}
                            </div>
                            <div class="col-md-5">
                                {{ form_row(registrationForm.postalCode) }}
                            </div>
                        </div>
                        {{ form_row(registrationForm.plainPassword, {
                            label: 'Mot de passe'
                        }) }}
                        <div class="alert alert-info small" role="alert">
                            Votre mot de passe doit contenir au minimum 12 caracteres, incluant
                            une majuscule, une minuscule, un chiffre et un caractere special.
                        </div>
                        {{ form_row(registrationForm.agreeTerms, {
                            label: 'J\'accepte les conditions d\'utilisation'
                        }) }}

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Creer mon compte</button>
                        </div>
                    {{ form_end(registrationForm) }}
                    <p class="mb-0 mt-3 text-center">
                        Deja inscrit ? <a href="{{ path('app_login') }}">Connectez-vous</a>.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
