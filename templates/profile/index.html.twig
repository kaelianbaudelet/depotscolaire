{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% form_theme profileForm 'bootstrap_5_layout.html.twig' %}
{% form_theme passwordForm 'bootstrap_5_layout.html.twig' %}

{% block flash_messages %}{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <h1 class="h3 mb-4 text-center">Mon profil</h1>
            {{ include('components/_flash_messages.html.twig') }}
            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-body p-4">
                            <h2 class="h5 mb-3">Informations personnelles</h2>
                            {{ form_start(profileForm) }}
                                {{ form_row(profileForm.firstName) }}
                                {{ form_row(profileForm.lastName) }}
                                {{ form_row(profileForm.address) }}
                                <div class="row">
                                    <div class="col-md-7">
                                        {{ form_row(profileForm.city) }}
                                    </div>
                                    <div class="col-md-5">
                                        {{ form_row(profileForm.postalCode) }}
                                    </div>
                                </div>
                                <div class="d-grid">
                                    {{ form_widget(profileForm.save) }}
                                </div>
                            {{ form_end(profileForm) }}
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-body p-4">
                            <h2 class="h5 mb-3">Changer de mot de passe</h2>
                            <p class="text-muted small">
                                Le nouveau mot de passe doit contenir au minimum 12 caracteres et ne pas avoir ete utilise auparavant.
                            </p>
                            {{ form_start(passwordForm) }}
                                {{ form_row(passwordForm.currentPassword) }}
                                {{ form_row(passwordForm.newPassword.first) }}
                                {{ form_row(passwordForm.newPassword.second) }}
                                <div class="d-grid">
                                    {{ form_widget(passwordForm.submit) }}
                                </div>
                            {{ form_end(passwordForm) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
