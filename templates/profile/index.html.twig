{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}


{% block flash_messages %}{% endblock %}

{% block body %}
    <div class="page-wrapper">
        <div class="profile-grid">
            <div class="info-card">
                <h2 class="info-card__title">Mes informations</h2>
                {{ form_start(profileForm) }}
                <div class="field-group">
                    {{ form_row(profileForm.roleDisplay, {'attr': {'class': 'form-input bg-gray-input'}}) }}
                </div>
                <div class="field-group">
                    {{ form_row(profileForm.firstName, {'attr': {'class': 'form-input'}}) }}
                </div>
                <div class="field-group">
                    {{ form_row(profileForm.lastName, {'attr': {'class': 'form-input'}}) }}
                </div>
                <div class="field-group">
                    {{ form_row(profileForm.address, {'attr': {'class': 'form-input'}}) }}
                </div>
                
                <div class="form-row-city">
                    <div class="field-group">
                        {{ form_row(profileForm.city, {'attr': {'class': 'form-input'}}) }}
                    </div>
                    <div class="field-group">
                        {{ form_row(profileForm.postalCode, {'attr': {'class': 'form-input'}}) }}
                    </div>
                </div>

                <div class="form-actions">
                    {{ form_widget(profileForm.save, {'attr': {'class': 'app-btn app-btn--primary'}}) }}
                </div>
                {{ form_end(profileForm) }}
            </div>

            <!-- Password Change -->
            <div class="info-card">
                <h2 class="info-card__title">Changer de mot de passe</h2>
                <p class="info-card__description">
                    Le nouveau mot de passe doit contenir au minimum 12 caractères et ne pas avoir été utilisé auparavant.
                </p>
                {{ form_start(passwordForm) }}
                    <div class="field-group">
                        {{ form_row(passwordForm.currentPassword, {'attr': {'class': 'form-input'}}) }}
                    </div>
                    <div class="field-group">
                        {{ form_row(passwordForm.newPassword.first, {'attr': {'class': 'form-input'}}) }}
                    </div>
                    <div class="field-group">
                        {{ form_row(passwordForm.newPassword.second, {'attr': {'class': 'form-input'}}) }}
                    </div>
                    <div class="form-actions">
                        {{ form_widget(passwordForm.submit, {'attr': {'class': 'app-btn app-btn--primary'}}) }}
                    </div>
                {{ form_end(passwordForm) }}
            </div>
        </div>
    </div>
    </div>
</div>
{% endblock %}
