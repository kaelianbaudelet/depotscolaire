{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe{% endblock %}


{% block body %}
<div class="center-wrapper">
    <div class="auth-card">
        <h1 class="auth-header">Définir un nouveau mot de passe</h1>
        
        {{ form_start(resetForm) }}
            <div class="field-group">
                {{ form_row(resetForm.newPassword.first, {'attr': {'class': 'form-input'}}) }}
            </div>
            <div class="field-group">
                {{ form_row(resetForm.newPassword.second, {'attr': {'class': 'form-input'}}) }}
            </div>
        {{ form_end(resetForm) }}
    </div>
</div>
{% endblock %}

