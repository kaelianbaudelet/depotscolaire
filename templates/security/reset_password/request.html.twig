{% extends 'base.html.twig' %}

{% block title %}Réinitialiser le mot de passe{% endblock %}

{% block body %}
<div class="center-wrapper">
    <div class="auth-card">
        <h1 class="auth-header">Réinitialiser le mot de passe</h1>
        
        <p class="text-center text-muted mb-md">
            Entrez votre adresse email et nous vous enverrons un lien pour réinitialiser votre mot de passe.
        </p>

        {{ form_start(requestForm) }}
            <div class="field-group">
                {{ form_row(requestForm.email, {'attr': {'class': 'form-input'}}) }}
            </div>
        {{ form_end(requestForm) }}

        <p class="auth-footer">
            <a href="{{ path('app_login') }}" class="auth-footer__link">Retour à la connexion</a>
        </p>
    </div>
</div>
{% endblock %}
