{% extends 'base.html.twig' %}

{% block title %}Reinitialisation{% endblock %}

{% form_theme requestForm 'bootstrap_5_layout.html.twig' %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h4 mb-3 text-center">Reinitialiser le mot de passe</h1>
                    <p class="text-muted small mb-4 text-center">
                        Indiquez votre adresse email pour recevoir un lien de reinitialisation.
                    </p>
                    {{ form_start(requestForm) }}
                        {{ form_row(requestForm.email) }}
                        <div class="d-grid">
                            {{ form_widget(requestForm.submit) }}
                        </div>
                    {{ form_end(requestForm) }}
                    <p class="mb-0 mt-3 text-center">
                        <a href="{{ path('app_login') }}">Retour a la connexion</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

